# Required: API key for LLM access
OPENAI_API_KEY="<YOUR_OPENAI_API_KEY>"

# Optional: Evolve Backend Configuration (default: filesystem)
# EVOLVE_BACKEND=filesystem  # Options: filesystem, postgres, milvus
# EVOLVE_NAMESPACE_ID=evolve

# Optional: LLM Configuration
# EVOLVE_MODEL_NAME=gpt-4o
# EVOLVE_CUSTOM_LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Guideline Generation
# EVOLVE_GUIDELINES_MODE=standard  # Options: standard, consistency, all
# EVOLVE_GUIDELINES_MODEL=gpt-4o  # Model used to generate guidelines
# EVOLVE_SEGMENTATION_ENABLED=false  # Set to true to segment trajectories into subtasks

# Optional: Debug mode
# EVOLVE_DEBUG_DIR=/tmp/evolve_debug  # Write debug artifacts to this directory

# Optional: Advanced Settings
# EVOLVE_CLUSTERING_THRESHOLD=0.80

# Optional: Postgres backend (requires: pip install altk-evolve[pgvector])
# EVOLVE_BACKEND=postgres
# EVOLVE_PG_HOST=127.0.0.1
# EVOLVE_PG_PORT=5432
# EVOLVE_PG_USER=postgres
# EVOLVE_PG_PASSWORD=postgres  # pragma: allowlist secret
# EVOLVE_PG_DBNAME=evolve
# EVOLVE_PG_AUTO_CREATE_DB=true
# EVOLVE_PG_BOOTSTRAP_DB=postgres

# Optional: Milvus backend (requires: pip install altk-evolve[milvus])
# EVOLVE_BACKEND=milvus

# Consistency metrics default to MiniLM (small) and CodeRankEmbed (large).
# Override only when a different metric model is needed. Changing models changes scores;
# review consistency thresholds when upgrading an existing deployment.
# EVOLVE_CONSISTENCY_EMBEDDING_MODEL_SMALL=sentence-transformers/all-MiniLM-L6-v2
# EVOLVE_CONSISTENCY_EMBEDDING_MODEL_LARGE=nomic-ai/CodeRankEmbed
# Required for other explicitly selected SentenceTransformers models needing custom code.
# The built-in CodeRankEmbed model uses pinned official custom code automatically.
# EVOLVE_CONSISTENCY_EMBEDDING_TRUST_REMOTE_CODE=true

# Embeddings: sentence_transformers (default) or fastembed (install altk-evolve[fastembed]).
# FastEmbed can reuse an existing ONNX cache; its weights differ from SentenceTransformers.
# Reindex existing vectors before changing the embedding model/provider.
# EVOLVE_EMBEDDING_PROVIDER=fastembed
# EVOLVE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EVOLVE_PG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# FASTEMBED_CACHE_PATH=/app/.cache/fastembed


# Consistency defaults: MiniLM for sbert_small, CodeRankEmbed for sbert_large.
# Both providers accept the same model names; overrides remain optional.
# FastEmbed CodeRankEmbed requires Evolve's own validated export at build time:
# uv run --extra fastembed-export python -m altk_evolve.export_embeddings
# This downloads only pinned official nomic-ai/CodeRankEmbed source weights.
# No community exports, conversion or PyTorch inference are used at runtime.

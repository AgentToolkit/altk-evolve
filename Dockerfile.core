FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# Install system dependencies
RUN microdnf install -y \
    python3.12 \
    python3.12-pip \
    git \
    tar \
    gzip \
    && microdnf clean all

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy project files
COPY pyproject.toml uv.lock ./
COPY altk_evolve ./altk_evolve
COPY packages/altk-evolve ./packages/altk-evolve
COPY README.md LICENSE MANIFEST.in ./

# Install the MCP server and the default embedding runtime.
RUN uv sync --frozen --no-dev --extra server --extra fastembed

# Gate publication on the actual entrypoint imports and optional runtime.
RUN .venv/bin/python -c "import altk_evolve.frontend.mcp.__main__; import fastembed"

# Set environment variables for filesystem backend
ENV EVOLVE_BACKEND=filesystem
ENV EVOLVE_NAMESPACE_ID=evolve

# Expose MCP server (stdio-based, no port needed)
# The MCP server runs via stdio, not HTTP

# Activate the virtual environment
ENV PATH="/app/.venv/bin:${PATH}"

# Set the entrypoint to run the MCP server directly from venv
ENTRYPOINT ["python", "-m", "altk_evolve.frontend.mcp"]

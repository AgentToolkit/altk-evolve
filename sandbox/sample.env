ANTHROPIC_API_KEY=sk-ant-xxxx
#OPENAI_API_KEY=sk-xxxx # pragma: allowlist secret
EVOLVE_DEBUG=1
IS_SANDBOX=1

# Codex sandbox only. Leave all four unset to talk to OpenAI directly with
# OPENAI_API_KEY above. To route through a gateway, set CODEX_MODEL_PROVIDER
# *and* CODEX_MODEL_PROVIDER_BASE_URL together — a provider without a base URL
# produces a config.toml referencing an undefined provider, which surfaces as an
# opaque auth failure. CODEX_MODEL_PROVIDER_ENV_KEY names the environment
# variable holding the credential (default OPENAI_API_KEY); that variable is
# forwarded into the container, so export it too.
#CODEX_MODEL_PROVIDER=my-gateway
#CODEX_MODEL_PROVIDER_BASE_URL=https://gateway.example.com/v1
#CODEX_MODEL_PROVIDER_ENV_KEY=MY_GATEWAY_API_KEY
#CODEX_MODEL_PROVIDER_WIRE_API=chat
#CODEX_MODEL=gpt-5
